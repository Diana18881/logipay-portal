# Server-only Fleetboard connector settings. Never expose these values to browser code.
FLEETBOARD_API_URL=https://www.webservices.fleetboard.com/
FLEETBOARD_API_USER=
FLEETBOARD_API_PASSWORD=

# Shared bearer token used by the protected Fleetboard JSON bridge endpoint.
TRACKER_INGEST_TOKEN=

# Vercel deployment (Turso = SQLite, compatible with LOGIPAY schema)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Created automatically when you add a Blob store in the Vercel project
BLOB_READ_WRITE_TOKEN=

# Optional alias names
LOGIPAY_DATABASE_URL=
LOGIPAY_DATABASE_TOKEN=
